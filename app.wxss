page {
  --bg: #f7f4ef;
  --surface: #fbf9f5;
  --ink: #1a1a1a;
  --muted: #8a857c;
  --line: #e6e1d8;
  --red: #c23b2e;
  --red-soft: #f6e4e1;
  --blue: #1f5fbf;
  --blue-soft: #e3ebf8;
  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.55;
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  box-sizing: border-box;
}

view, text, button, input, textarea {
  box-sizing: border-box;
}

.brand {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  letter-spacing: 0.08em;
}

.btn-primary {
  background: var(--ink) !important;
  color: #fff !important;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 22rpx 0;
  line-height: 1.3;
  margin: 0;
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: transparent !important;
  color: var(--ink) !important;
  border: 2rpx solid var(--line);
  border-radius: 12rpx;
  font-size: 28rpx;
  margin: 0;
}

.btn-ghost::after {
  border: none;
}

.ratio-bar {
  display: flex;
  height: 18rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: var(--line);
}

.ratio-bar .red {
  background: var(--red);
  height: 100%;
}

.ratio-bar .blue {
  background: var(--blue);
  height: 100%;
}

.empty {
  padding: 120rpx 48rpx;
  text-align: center;
  color: var(--muted);
}
