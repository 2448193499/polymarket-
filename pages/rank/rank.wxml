<view class="page">
  <view class="intro">真金不进场，准不准进场。按多数结算累计段位分。</view>

  <view class="tabs">
    <view class="tab {{type==='total'?'on':''}}" data-type="total" bindtap="switchType">总榜</view>
    <view class="tab {{type==='week'?'on':''}}" data-type="week" bindtap="switchType">周榜</view>
  </view>

  <view class="list">
    <view class="row {{item.isMe?'me':''}}" wx:for="{{list}}" wx:key="id">
      <view class="place {{item.place<=3?'top':''}}">{{item.place}}</view>
      <view class="mid">
        <view class="name">{{item.nickName}}<text wx:if="{{item.isMe}}" class="you">我</text></view>
        <view class="sub">{{item.tierName}} · 胜率 {{item.winRate}}%</view>
      </view>
      <view class="score">
        <view class="n">{{type==='week' ? item.weekScore : item.rankScore}}</view>
        <view class="u">{{type==='week' ? '本周分' : '段位分'}}</view>
      </view>
    </view>
  </view>
</view>
