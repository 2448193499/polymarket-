.page {
  min-height: 100vh;
  padding: 32rpx;
}

.intro {
  margin-bottom: 28rpx;
}

.h {
  font-size: 40rpx;
  font-weight: 700;
}

.p {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.55;
}

.card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-h {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.li {
  font-size: 26rpx;
  color: #3a3834;
  line-height: 1.55;
  margin-bottom: 8rpx;
}

.meta {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
  line-height: 1.45;
}

.sync {
  margin-top: 20rpx !important;
  width: 100% !important;
}

.warn {
  font-size: 22rpx;
  color: #8a5a2b;
  background: #f7efe4;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  line-height: 1.5;
  margin-bottom: 28rpx;
}

.go {
  width: 100% !important;
}
