.page {
  min-height: 100vh;
  padding: 32rpx;
}

.profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 12rpx 0 20rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--red-soft), var(--blue-soft));
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 36rpx;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.info .name {
  font-size: 36rpx;
  font-weight: 700;
}

.info .name.muted {
  color: var(--muted);
  font-weight: 500;
}

.tier {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #161616;
  color: #fff;
}

.info .sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.stats {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
}

.stat-k {
  font-size: 22rpx;
  color: var(--muted);
  letter-spacing: 0.08em;
}

.stat-v {
  margin-top: 8rpx;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.1;
}

.slash {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--muted);
  margin-left: 4rpx;
}

.stat-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.checkin {
  margin-top: 16rpx !important;
  width: auto !important;
  display: inline-block;
  padding: 0 28rpx !important;
  height: 60rpx;
  line-height: 60rpx !important;
}

.checkin.off {
  background: #d8d3cb !important;
  color: #7a756c !important;
}

.record-grid {
  display: flex;
  margin-top: 16rpx;
  margin-bottom: 8rpx;
}

.rg {
  flex: 1;
  text-align: center;
}

.rg .n {
  font-size: 30rpx;
  font-weight: 800;
}

.rg .l {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.progress-wrap {
  margin-top: 12rpx;
}

.progress-bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.progress-bar .fill {
  height: 100%;
  background: linear-gradient(90deg, #c23b2e, #1f5fbf);
}

.progress-tip {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.board-btn {
  margin-top: 16rpx !important;
  width: auto !important;
  display: inline-block;
  padding: 0 24rpx !important;
  height: 56rpx;
  line-height: 56rpx !important;
}

.panel {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 28rpx;
}

.label {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}

.nick {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.row .nick {
  flex: 1;
  margin-bottom: 0;
  min-width: 0;
}

.save {
  flex-shrink: 0;
  padding: 0 22rpx !important;
  height: 72rpx !important;
  line-height: 72rpx !important;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nick-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8a857c;
}

.section-h {
  margin: 8rpx 0 4rpx;
  padding: 8rpx 4rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.item {
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid var(--line);
}

.item-title {
  font-size: 30rpx;
  font-weight: 600;
}

.item-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.done {
  color: #2f6b4f;
  font-weight: 700;
}

.red { color: var(--red); }
.blue { color: var(--blue); }

.reset {
  margin-top: 48rpx;
  width: 100%;
}
